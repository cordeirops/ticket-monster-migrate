<?xml version="1.0" encoding="UTF-8"?>
<datasources xmlns="http://www.jboss.org/ironjacamar/schema"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.jboss.org/ironjacamar/schema http://docs.jboss.org/ironjacamar/schema/datasources_1_0.xsd">
    <datasource jndi-name="java:jboss/datasources/PostgreSQLDS"
                pool-name="PostgreSQLDS" enabled="true" use-java-context="true">
        <connection-url>jdbc:postgresql://${env.DB_HOST:ticketmonster-db}:${env.DB_PORT:5432}/${env.DB_DATABASE:ticketmonster}</connection-url>
        <driver>ROOT.war_org.postgresql.Driver_42_7</driver>
        <security>
            <user-name>${env.DB_USERNAME:ticketmonster}</user-name>
            <password>${env.DB_PASSWORD:ticketmonster}</password>
        </security>
        <validation>
            <valid-connection-checker class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker"/>
            <exception-sorter class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter"/>
        </validation>
    </datasource>
</datasources>